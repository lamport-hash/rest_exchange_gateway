{
    "rest": {
        "port": 8080
    },
    "persistence": {
        "logPath": "data/orders.jsonl"
    },
    "defaultVenue": "okx",
    "risk": {
        "default": {
            "maxQty": "10",
            "maxNotional": "1000000",
            "maxPosition": "10"
        },
        "instruments": {
            "BTC-USDT": {
                "maxQty": "5",
                "maxNotional": "500000",
                "maxPosition": "2"
            }
        }
    },
    "okx": {
        "apiKey": "YOUR_OKX_DEMO_API_KEY",
        "secretKey": "YOUR_OKX_DEMO_SECRET_KEY",
        "passphrase": "YOUR_OKX_DEMO_PASSPHRASE",
        "host": "www.okx.com",
        "port": 443,
        "useTls": true,
        "demoTrading": true,
        "restConnectTimeoutMs": 5000,
        "restReadTimeoutMs": 5000,
        "retry": {
            "maxAttempts": 3,
            "initialBackoffMs": 100,
            "maxBackoffMs": 2000,
            "multiplier": 2.0,
            "jitter": 0.5,
            "budgetMs": 5000
        },
        "ws": {
            "enabled": true,
            "host": "ws.okx.com",
            "port": 8443,
            "useTls": true,
            "path": "/ws/v5/private",
            "pingIntervalMs": 20000,
            "maxMissedPongs": 2
        }
    },
    "binance": {
        "apiKey": "YOUR_BINANCE_TESTNET_API_KEY",
        "secretKey": "YOUR_BINANCE_TESTNET_SECRET_KEY",
        "host": "ws-api.testnet.binance.vision",
        "port": 443,
        "useTls": true,
        "path": "/ws-api/v3",
        "recvWindowMs": 5000,
        "requestTimeoutMs": 12000,
        "retry": {
            "maxAttempts": 3,
            "initialBackoffMs": 100,
            "maxBackoffMs": 2000,
            "multiplier": 2.0,
            "jitter": 0.5,
            "budgetMs": 5000
        }
    }
}
